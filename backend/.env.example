# GAS-INFO backend environment template
# Copy this file to .env for local development and fill in real values.
# NEVER commit a real .env file or expose secret values publicly.

NODE_ENV=development
PORT=3000

# Neon PostgreSQL connection string — get it from your Neon project.
# Keep the real value private; do not paste it into public chats or GitHub.
DATABASE_URL=

# Long random secret used to sign authentication tokens.
# Generate a unique value for each environment; never use a sample value in production.
JWT_SECRET=

# Frontend origin used by the backend's CORS configuration, if required.
FRONTEND_URL=http://localhost:5500

# Email provider settings — only needed after email verification/password reset
# is implemented in the backend. Fill these using your provider's credentials.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
